diff --git a/resize-observer.js b/resize-observer.js
new file mode 100644
index 0000000..cb796ec
--- /dev/null
+++ b/resize-observer.js
@@ -0,0 +1,34 @@
+export const observeResize = callback => {
+    const sizes = new WeakMap()
+    let frame = 0
+    let stopped = false
+    let targets = []
+    const observer = new ResizeObserver(entries => {
+        if (stopped) return
+        let changed = false
+        for (const { target, contentRect: { width, height } } of entries) {
+            if (!target.isConnected || width <= 0 || height <= 0) continue
+            const previous = sizes.get(target)
+            if (previous?.width === width && previous?.height === height) continue
+            sizes.set(target, { width, height })
+            targets.push(target)
+            changed = true
+        }
+        if (!changed || frame) return
+        frame = requestAnimationFrame(() => {
+            frame = 0
+            const connected = targets.some(target => target.isConnected)
+            targets = []
+            if (!stopped && connected) callback()
+        })
+    })
+    const disconnect = observer.disconnect.bind(observer)
+    observer.disconnect = () => {
+        stopped = true
+        if (frame) cancelAnimationFrame(frame)
+        frame = 0
+        targets = []
+        disconnect()
+    }
+    return observer
+}
