{
  "name": "siyuan-sireader",
  "version": "2.2.1",
  "type": "module",
  "description": "专业电子书阅读器，支持 EPUB/PDF/MOBI/TXT/在线小说；PDF 支持标注、表单、印章、签名、截图、搜索、打印、导出和回链，并提供词典、翻译、主题与书架管理 - 思阅 SiReader",
  "author": "mm-o",
  "license": "MIT",
  "homepage": "https://github.com/mm-o/siyuan-sireader",
  "repository": "https://github.com/mm-o/siyuan-sireader",
  "scripts": {
    "dev": "vite build --watch",
    "release": "node ./release.js",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major",
    "build": "vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@embedpdf/default-stamps": "0.0.1",
    "@embedpdf/snippet": "2.14.4",
    "@vueuse/motion": "^3.0.3",
    "fflate": "^0.8.2",
    "foliate-js": "github:readest/foliate-js#dd71f2be356563c16a23272686189fcfb45d0b82",
    "jszip": "^3.10.1",
    "vue": "^3.3.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@types/node": "^20.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-perfectionist": "^4.2.0",
    "fake-indexeddb": "^6.0.0",
    "fast-glob": "^3.2.12",
    "jsdom": "^25.0.1",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.62.1",
    "siyuan": "1.1.0",
    "typescript": "^5.0.4",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^2.1.8"
  }
}
